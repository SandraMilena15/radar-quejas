      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Fecha de corte del dataset (definida en el diccionario de datos)\nconst corte = '2026-10-29';\n// Festivos de Colombia en el periodo del dataset\nconst festivos = ['2026-10-12'];\n\nlet dia = new Date($json.fecha_radicacion + 'T00:00:00Z');\nlet diasHabiles = 0;\n\n// Cuenta día por día desde el siguiente a la radicación hasta la fecha de corte\nwhile (dia.toISOString().slice(0, 10) < corte) {\n  dia.setUTCDate(dia.getUTCDate() + 1);\n  const fecha = dia.toISOString().slice(0, 10);\n  const diaSemana = dia.getUTCDay(); // 0 = domingo, 6 = sábado\n  if (diaSemana !== 0 && diaSemana !== 6 && !festivos.includes(fecha)) {\n    diasHabiles++;\n  }\n}\n\nreturn { json: { ...$json, dias_habiles_abiertos: diasHabiles } };"
      },
