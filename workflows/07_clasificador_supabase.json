        "query": "select q.id_solicitud, q.canal, q.producto, q.comentario\nfrom quejas q\nwhere q.comentario is not null\n  and not exists (\n    select 1 from clasificaciones c\n    where c.id_solicitud = q.id_solicitud\n      and c.version_prompt = 'v1'\n  )\norder by q.id_solicitud\nlimit 200;",
